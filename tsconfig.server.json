{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "."
  },
  "include": ["server", "shared", "scripts/*.ts", "scripts/history/*.ts"],
  "exclude": ["node_modules"]
}
