# Green Monkey configuration. All values below are placeholders.
# Replace placeholders only in a local ignored .env or provider secret store.

# ---- Operations (docs/OPERATIONS.md, docs/RUNBOOK.md) ----
# development | test | staging | production. Staging/production refuse
# migration, backup and provisioning credentials and STRIPE_SECRET_KEY in the
# web process, and DATABASE_URL in the worker (server/config-rules.ts).
APP_ENV=development
# web | worker. Railway sets it per service; locally `npm run worker` is detected.
PROCESS_KIND=
LOG_LEVEL=info
# Runtime pool size (default 20) and per-transaction statement timeout in ms.
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT_MS=10000
# Railway graceful shutdown window (web 20, worker 30).
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=
# Express trust proxy: unset = "loopback, 100.0.0.0/8" in production.
TRUST_PROXY=
# Worker /healthz for /api/ops/status (Railway: http://worker.railway.internal:3002).
WORKER_URL=
# Local worker port when web and worker share this file (default 3002).
WORKER_PORT=
# Optional error tracking (install @sentry/node to enable).
SENTRY_DSN=
# Alerts: ntfy topic URL (default kind) or a slack/discord/generic webhook.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=ntfy
# Backups and provisioning only (GitHub Actions / operator shell); never in Railway web.
BACKUP_DATABASE_URL=
PROVISION_DATABASE_URL=

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
RESTAURANT_TZ=America/Mexico_City
VITE_API_BASE=/api

# Runtime role: least privilege and RLS. Never put owner credentials here.
DATABASE_URL=postgresql://app_user:replace-me@ep-example-pooler.region.aws.neon.tech/green_monkey?sslmode=verify-full
# Retained compatibility names: resolver must document precedence.
# Optional consistency check: if set, must match DATABASE_URL username.
PG_APP_USER=
# Retained compatibility name; currently unused (no implicit credential rewrite).
PG_APP_PASSWORD=

# Local migrations and tests only. Deployed: a GitHub Actions environment secret
# (deploy job and retention workflow), never a Railway variable (both runtime
# processes refuse it). TLS is always verified off-host.
MIGRATION_DATABASE_URL=postgresql://migration_user:replace-me@ep-example.region.aws.neon.tech/green_monkey?sslmode=verify-full
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
TEST_DATABASE_HOST_ALLOWLIST=
TEST_MIGRATION_DATABASE_HOST_ALLOWLIST=

# Web only. Verifies legacy-format tokens and keys the lookup digests (pairing
# codes, PIN fingerprints, invitation and transfer tokens); still required.
JWT_SECRET=replace-with-an-environment-specific-random-secret
# Legacy admin access is disabled unless deliberately implemented/configured.
ADMIN_SECRET=
# Google owner sign-in: server only. All three values enable the login entry.
# Redirect must match APP_URL origin and end in /api/auth/google/callback.
# Real Google login still needs provider/staging verification before release.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Development only; production must resolve an authenticated tenant.
DEFAULT_TENANT_ID=

# All integrations below are optional until explicitly configured and verified.
BILLING_SANDBOX_ENABLED=false
# Separate restricted login, member of gm_billing_worker, same pooled DB target.
# Web (owner billing commands) and worker (provider loop) use it.
BILLING_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Approved Pro subscription prices; legacy price names above are unused.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Required by sandbox catalog provisioning to prevent configuring the wrong account.
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_PRICE_FOUNDERS=

MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=

GETNET_ENABLED=false
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_MERCHANT_ID=
GETNET_WEBHOOK_SECRET=

# Clip stays disabled until its real API/device contract is verified.
CLIP_API_KEY=
CLIP_SECRET_KEY=
CLIP_DEFAULT_TERMINAL_ID=

FEATURE_MENU_PHOTOS=false
VITE_FEATURE_MENU_PHOTOS=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=

RESEND_API_KEY=
ANTHROPIC_API_KEY=
# Server-only; enables the optional judgment-assist modules in docs/FEATURE_MATRIX.md.
TYPESAFE_API_KEY=
ENABLE_BACKGROUND_EMAIL=false
ENABLE_BACKGROUND_SMS=false

# Explicit disposable localhost-only seed authorization; never set in staging/production.
ALLOW_DEMO_SEED=

# Optional explicit empty staging/test fixture initialization and browser smoke.
# Never enable these on a real restaurant database.
FIXTURE_TARGET_ALLOWLIST=
FIXTURE_OWNER_PASSWORD=
FIXTURE_CASHIER_PIN=
FIXTURE_KITCHEN_PIN=
STAGING_URL=
STAGING_ORIGIN_ALLOWLIST=

# Access (pairing, PIN sign-in, step-up).
# DEMO_TENANT_ID enables the demo owner form and owner-password pairing for one
# fictional tenant: local or the fictional staging tenant only. Never set it in
# production (the server refuses to start when RAILWAY_ENVIRONMENT_NAME or
# APP_ENV is production).
DEMO_TENANT_ID=
# Seconds a PIN stays fresh for sensitive commands on shared terminals
# (30..1800, default 120; the browser suites use 1800).
ACCESS_STEP_UP_SECONDS=
# Default terminal auto-lock in seconds when a device has no setting
# (0, 60, 120, 180, 300, 600 or 900; 0 = never; default 180; tests use 0).
ACCESS_IDLE_LOCK_DEFAULT_SECONDS=

# ---- Wave 2.0 registered variables (.railway/railway.ts declares each per service) ----
# Empty means unset everywhere. Areas validate their own values (server/config-rules.ts markers).

# -- web only --
# OPS-10 keyring: "kid:base64url(>=32 bytes)[,kid:…]"; the first entry signs, all verify.
# Generate with `node scripts/ops/generate-signing-key.mjs`. A deployed web (staging or
# production) requires it and refuses placeholder, CI or local keys (placeholder_signing_keys).
# Rotation: docs/RUNBOOK.md "Signing keys". A deployed worker refuses it.
SIGNING_KEYS=
# fiscal (027): set to false only as an emergency kill switch (default true).
FISCAL_TICKETS_ENABLED=
# cfdi (030): customer self-invoice link lifetime in hours (1-168, default 72).
CFDI_INVOICE_LINK_EXPIRY_HOURS=
# account (031, LD-3): real values only; empty or placeholder keeps legal pages unpublished
# and pauses signup in production.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_RFC=
LEGAL_JURISDICTION=
LEGAL_PRIVACY_CONTACT_NAME=
LEGAL_PRIVACY_CONTACT_EMAIL=
# Only "allow" has an effect, and only outside APP_ENV=production.
LEGAL_UNPUBLISHED_SIGNUP=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_URL=
SUPPORT_HOURS=
SUPPORT_HOURS_EN=
# Local browser runs only: the FICTIONAL set CI publishes (LD-3), the same literals
# as server/legal-ci.ts; `scripts/compiled-local.sh` exports them through
# tests/fixtures/legal-ci.sh. Test values: never copy them to Railway or any
# deployed environment (production refuses them and stays unpublished).
# LEGAL_ENTITY_NAME="Nopal Verde Software S.A. de C.V."
# LEGAL_ENTITY_ADDRESS="Calle Jacaranda 120, Col. Centro, 06000 Ciudad de México, CDMX"
# LEGAL_PRIVACY_CONTACT_EMAIL="privacidad@nopalverde.mx"
# LEGAL_JURISDICTION="Ciudad de México"
# SUPPORT_EMAIL="soporte@nopalverde.mx"
# SUPPORT_PHONE="+525512345678"
# SUPPORT_HOURS="Lun–Sáb 9:00–21:00 (hora del centro)"
# LEGAL_UNPUBLISHED_SIGNUP=allow
SAAS_TAX_PROFILE_ENABLED=
# QR/kiosk ordering kill switch (public ordering 032/033): unset = on everywhere; false = off.
PUBLIC_ORDERING_ENABLED=
# kiosk (039): card at the kiosk and menu photos; unset or "true" = on, "false" = off.
# Railway: preserve() on staging; "false" in production until the kiosk field checks and
# the device rehearsal pass (LAUNCH_HANDOFF.md 1.16a).
KIOSK_SELF_CHECKOUT_ENABLED=
MENU_PHOTOS_ENABLED=
# Menu photos store (web only; the worker refuses the keys): "r2" with the owner's private
# bucket and a bucket-scoped, non-expiring Object Read & Write token. Empty = no photos
# (uploads answer media_store_not_configured, menus show text tiles).
MEDIA_STORE=
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_BUCKET=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=

# -- web and worker --
SAAS_TAX_MODE=
SAAS_COLLECT_TAX_ID=

# -- worker only (a deployed web refuses the database URL, the Facturapi keys,
#    CREDENTIAL_ENCRYPTION_KEY and CFDI_LIVE_ENABLED) --
# Jobs login gm_<env>_worker (member of gm_jobs_worker); local: gm_worker.
WORKER_DATABASE_URL=postgresql://gm_worker:local-only-worker@127.0.0.1:55439/green_monkey_dev
STRIPE_TAX_RATE_ID=
FACTURAPI_API_KEY=
FACTURAPI_TEST_KEY=
CREDENTIAL_ENCRYPTION_KEY=
CFDI_LIVE_ENABLED=false
CFDI_GLOBAL_GRACE_MINUTES=60
# payments (037 P2): integrated charging (mercadopago, clip; empty = off, manual terminals
# only). Railway: staging mercadopago,clip; production undeclared until the device rehearsal.
PAYMENTS_PROVIDERS=

# -- never Railway variables --
# Development/test only, loopback host (cfdi fake): FACTURAPI_BASE_URL=
# Development/test only, loopback host (payments fake): MERCADOPAGO_API_URL= CLIP_API_URL=
# Operator workstation only; both processes refuse it: SUPPORT_DATABASE_URL=
# Development/CI only, a local directory (refused in staging and production while photos
# are on; a Railway disk does not survive a deploy): MEDIA_STORE=fs MEDIA_FS_ROOT=
# Optional test override for a non-loopback test cluster (tests/isolated-target.ts):
TEST_WORKER_DATABASE_URL=
