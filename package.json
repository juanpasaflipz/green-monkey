{
  "name": "green-monkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/*.test.ts",
    "stripe:catalog:sandbox": "tsx scripts/stripe-sandbox-catalog.ts",
    "test:db": "npm run test:db:core",
    "test:db:core": "tsx tests/database.ts",
    "test:db:identity": "tsx tests/google-attempts-db.ts && tsx tests/owner-accounts-db.ts",
    "test:db:owner": "tsx tests/owner-management-db.ts",
    "test:db:entitlements": "tsx tests/entitlements-db.ts",
    "test:db:ops": "tsx tests/ops-db.ts && tsx tests/migrate-db.ts && tsx tests/jobs-db.ts && tsx tests/backup-db.ts && tsx tests/provision-db.ts",
    "test:drain": "tsx tests/drain-http.ts",
    "worker": "tsx server/worker.ts",
    "start:worker": "node --import ./build/server/instrument.js build/server/worker.js",
    "ops:retention": "tsx scripts/migrate.ts --retention-only",
    "ops:backup": "tsx scripts/ops/backup.ts",
    "ops:rehearse-restore": "tsx scripts/ops/rehearse-neon-restore.ts",
    "load:seed": "tsx scripts/load/seed-load.ts",
    "load:run": "tsx scripts/load/run-load.ts",
    "test:db:billing": "tsx tests/billing-db.ts",
    "test:db:free": "tsx tests/free-limits-db.ts",
    "test:db:access": "tsx tests/access-db.ts",
    "test:access-http": "tsx tests/access-http.ts",
    "access:pairing-code": "tsx scripts/pairing-code.ts",
    "test:db:recovery": "tsx tests/offline-recovery-db.ts",
    "test:db:qualification": "npm run test:db:core && npm run test:db:identity && npm run test:db:owner && npm run test:db:entitlements && npm run test:db:billing && npm run test:db:free && npm run test:db:recovery && npm run test:db:voids && npm run test:db:ops && npm run test:db:access && npm run test:db:service && npm run test:db:menu && npm run test:db:offline && npm run test:db:fiscal && npm run test:db:discounts && npm run test:db:reports && npm run test:db:cfdi && npm run test:db:account && npm run test:db:support",
    "test:browser": "playwright test",
    "test:db:service": "tsx tests/service-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:grants": "tsx scripts/apply-grants.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:db:menu": "tsx tests/menu-db.ts",
    "db:local": "bash scripts/local-db.sh",
    "import:dry-run": "tsx scripts/import.ts",
    "setup:local": "bash scripts/setup-local.sh",
    "test:db:offline": "tsx tests/offline-sync-db.ts",
    "test:db:discounts": "tsx tests/discounts-db.ts",
    "test:restart": "tsx tests/restart-http.ts",
    "test:db:voids": "tsx tests/voids-db.ts",
    "test:db:fiscal": "tsx tests/fiscal-db.ts",
    "test:db:reports": "tsx tests/reports-db.ts && tsx tests/reports-phaseb-db.ts",
    "dev:facturapi-fake": "tsx tests/fakes/facturapi-fake.ts",
    "test:db:cfdi": "tsx tests/cfdi-db.ts",
    "test:facturapi:sandbox": "tsx tests/cfdi-facturapi-sandbox.ts",
    "cfdi:rekey": "tsx scripts/cfdi-rekey.ts",
    "test:db:account": "tsx tests/account-db.ts",
    "test:db:support": "tsx tests/support-db.ts",
    "test:account-http": "tsx tests/account-http.ts",
    "support": "tsx scripts/support.ts",
    "support:provision": "tsx scripts/provision-support-operator.ts",
    "stripe:tax-rate:sandbox": "tsx scripts/stripe-sandbox-tax-rate.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dexie": "4.3.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "lucide-react": "1.45.0",
    "postgres": "3.4.8",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
