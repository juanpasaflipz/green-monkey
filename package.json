{
  "name": "green-monkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/domain.test.ts tests/plans.test.ts tests/google-identity.test.ts tests/stripe-catalog.test.ts tests/stripe-billing.test.ts",
    "stripe:catalog:sandbox": "tsx scripts/stripe-sandbox-catalog.ts",
    "test:db": "tsx tests/database.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "bash scripts/local-db.sh",
    "import:dry-run": "tsx scripts/import.ts",
    "setup:local": "bash scripts/setup-local.sh"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dexie": "4.3.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "lucide-react": "1.45.0",
    "postgres": "3.4.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
